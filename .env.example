# Copy to .env (git-ignored) and adjust. Read by `make run`.

# PostgreSQL connection for the API and the worker.
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel?sslmode=disable

# Where the API listens. `make run` defaults HOST to 127.0.0.1; leave HOST
# empty to listen on all interfaces.
HOST=127.0.0.1
PORT=8080

# Fixed seed tokens, so they survive restarts. Leave unset to have them
# generated and printed once on the first run.
# SEED_ADMIN_TOKEN=
# SEED_MONITOR_TOKEN=
# SEED_DEPLOY_TOKEN=
