# Copy to .env (git-ignored). `make up` does this for you. Read by `make up`
# (the Compose stack), `make run` (processes on your machine) and
# scripts/demo.py.

# LOCAL DEMO ONLY. These fixed tokens let the demo and the UI work without
# copying generated ones. Anyone who can reach the API can use them: never
# reuse them anywhere else.
SEED_ADMIN_TOKEN=sk_usr_local_demo_only_admin_token_not_secret_0001
SEED_MONITOR_TOKEN=sk_int_local_demo_only_monitor_token_not_secret_01
SEED_DEPLOY_TOKEN=sk_int_local_demo_only_deploy_token_not_secret_001

# `make run` and `make up` add demo incidents to explore after seeding.
# Set to 0 to start with an empty tenant.
# SEED_DEMO_DATA=1

# Published ports of the Compose stack (all on 127.0.0.1). `make run`,
# `make test` and scripts/demo.py follow them.
# SENTINEL_DB_PORT=5432
# SENTINEL_API_PORT=8080
# SENTINEL_UI_PORT=5173

# Used by `make run` only (the Compose stack sets its own).
# PostgreSQL connection for the API and the worker. Defaults to the Compose
# database on SENTINEL_DB_PORT.
# DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel?sslmode=disable
# Where the API listens. Leave HOST empty to listen on all interfaces.
HOST=127.0.0.1
PORT=8080
